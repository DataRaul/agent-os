    {
      "id": "bri-001-easy-clean-success",
      "level": "easy",
      "scenario": "A bounded runner executes the declared candidate and configuration, performs the expected work, persists one fresh artifact bound to the run, meets every declared positive and negative postcondition, and leaves protected state unchanged.",
      "expected_focus": [
        "exact run binding",
        "positive and negative postconditions",
        "RUN_INTEGRITY_PASS"
      ],
      "expected_disposition": "RUN_INTEGRITY_PASS",
      "record": {
        "schema_version": 1,
        "work_class": "BOUNDED_EVIDENCE_PRODUCING_RUN",
        "candidate_identity": "candidate-a",
        "runner_identity": "runner-v1",
        "authority_source_declaration": "caller-declared-existing-authority",
        "authority_granted": false,
        "contract": {
          "preconditions": [
            "authority-present",
            "inputs-present",
            "thresholds-predeclared"
          ],
          "positive_postconditions": [
            "minimum-output-met",
            "persistence-complete"
          ],
          "negative_postconditions": [
            "no-duplicate-effects",
            "no-stale-evidence"
          ],
          "persistence_required": true,
          "protected_state_checks_required": true,
          "partial_result_allowed": false
        },
        "inputs_configuration": {
          "mode": "bounded",
          "limit": 10
        },
        "evidence": {
          "authoritative_evidence_available": true,
          "preconditions": [
            {
              "id": "authority-present",
              "status": "PASS"
            },
            {
              "id": "inputs-present",
              "status": "PASS"
            },
            {
              "id": "thresholds-predeclared",
              "status": "PASS"
            }
          ],
          "runner_executed": true,
          "observed_candidate_identity": "candidate-a",
          "observed_inputs_configuration": {
            "mode": "bounded",
            "limit": 10
          },
          "expected_work_occurred": true,
          "source_failure_evidence_status": "COMPLETE",
          "source_failures": [],
          "warnings": [],
          "artifacts": [
            {
              "artifact_id": "artifact-run-a",
              "candidate_identity": "candidate-a",
              "inputs_configuration": {
                "mode": "bounded",
                "limit": 10
              },
              "fresh": true,
              "persisted": true,
              "run_identity": "run-a"
            }
          ],
          "positive_postconditions": [
            {
              "id": "minimum-output-met",
              "status": "PASS"
            },
            {
              "id": "persistence-complete",
              "status": "PASS"
