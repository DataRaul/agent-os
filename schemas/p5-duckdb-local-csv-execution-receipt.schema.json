{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent OS P5 DuckDB Local CSV Execution Receipt V1",
  "description": "Receipt for the bounded execution profile that connects P5 contracts to the admitted duckdb-local-csv-aggregate adapter.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_type",
    "execution_status",
    "runtime_scope",
    "public_base_sha",
    "registry_sha256",
    "request_sha256",
    "capability_id",
    "capability_contract_version",
    "adapter_id",
    "adapter_input_sha256",
    "input_file_sha256_before",
    "input_file_sha256_after",
    "output_sha256",
    "output",
    "precondition_result",
    "postcondition_result",
    "authority_source",
    "registry_authority_granted",
    "external_authority_used",
    "side_effects",
    "executable"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "contract_type": {"const": "P5_DUCKDB_LOCAL_CSV_EXECUTION_RECEIPT"},
    "execution_status": {"const": "EXECUTED"},
    "runtime_scope": {"const": "BOUND_REAL_DUCKDB_LOCAL_CSV_ADAPTER"},
    "public_base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capability_id": {"const": "duckdb-local-csv-aggregate"},
    "capability_contract_version": {"const": 1},
    "adapter_id": {"const": "duckdb-local-csv-aggregate-v1"},
    "adapter_input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_file_sha256_before": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_file_sha256_after": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "operation", "column", "result"],
      "properties": {
        "adapter": {"const": "duckdb-local-csv-aggregate-v1"},
        "operation": {"enum": ["count", "sum"]},
        "column": {"type": ["string", "null"]},
        "result": {"type": "string"}
      }
    },
    "precondition_result": {"type": "object"},
    "postcondition_result": {"type": "object"},
    "authority_source": {"const": "CALLER_EXPLICIT_LOCAL_READ_AND_PROCESS_AUTHORITY"},
    "registry_authority_granted": {"const": false},
    "external_authority_used": {"const": true},
    "side_effects": {"type": "array", "maxItems": 0},
    "executable": {"const": true}
  }
}
