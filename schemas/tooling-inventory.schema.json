{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-os/tooling-inventory.schema.json",
  "title": "Agent OS tooling inventory",
  "type": "object",
  "required": [
    "schema_version",
    "snapshot_date",
    "rules",
    "source_evidence",
    "summary",
    "marketplace_plugins",
    "audited_subcapabilities"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "snapshot_date": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "rules": {
      "type": "object"
    },
    "source_evidence": {
      "type": "object"
    },
    "summary": {
      "type": "object"
    },
    "marketplace_plugins": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "audited_subcapabilities": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
